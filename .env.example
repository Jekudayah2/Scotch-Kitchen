# =============================================================================
# SCOTCH's Kitchen — environment variables
#
# Copy this file to .env.local for local development. Never commit real values.
#
# Variables prefixed VITE_ are bundled into the browser and are PUBLIC.
# Secrets (Paystack secret key, Supabase service-role key) must NEVER use the
# VITE_ prefix. They are set as Supabase Edge Function secrets instead — see
# the "Server secrets" section at the bottom and the README.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project Settings → API. The anon/publishable key is safe for browsers because
# Row Level Security protects every table.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Alternatively use the newer publishable key name (takes precedence if set):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of this site (used for auth + payment redirects). No trailing slash.
VITE_SITE_URL=http://localhost:5173

# --- Store location (verify on site before launch; do not guess) ---------------
# Leave blank until verified. Maps then show no store pin rather than a guess.
VITE_STORE_LATITUDE=
VITE_STORE_LONGITUDE=
# Human-readable delivery area shown on the storefront.
VITE_STORE_AREA_LABEL=KNUST & Kumasi

# --- Maps (free defaults, no API key needed) ------------------------------------
# Any MapLibre-compatible style URL. Defaults: OpenFreeMap positron / dark.
VITE_MAP_STYLE_URL=
VITE_MAP_STYLE_URL_DARK=
# Optional camera default "lat,lng" used before a pin is chosen (defaults to Kumasi centre).
VITE_MAP_DEFAULT_CENTER=
# Geocoder for "Search location". Defaults to OpenStreetMap Nominatim (fair-use policy applies).
VITE_GEOCODER_URL=

# --- Public contact details (optional; hidden when blank) -----------------------
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=
VITE_INSTAGRAM_URL=

# =============================================================================
# Server secrets — DO NOT put these in .env.local. Set them with:
#   npx supabase secrets set PAYSTACK_SECRET_KEY=sk_live_... SITE_URL=https://...
#
#   PAYSTACK_SECRET_KEY   Paystack Dashboard → Settings → API Keys (sk_test_/sk_live_)
#   SITE_URL              Public site URL, used for Paystack's callback_url
#   ALLOWED_ORIGINS       Comma-separated origins allowed to call the payment functions
#   STORE_LATITUDE        Optional, verified store pin for future routing work
#   STORE_LONGITUDE       Optional, verified store pin for future routing work
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by Supabase.
#
# Paystack's PUBLIC key is not needed: checkout uses Paystack's hosted page via
# a server-initialised transaction.
# =============================================================================
